---
import { getCollection } from 'astro:content';

// One node per project. Only what the script needs; the table below carries everything else.
const entries = await getCollection('work');
const nodes = entries
  .map((e) => ({ slug: e.id, title: e.data.title, domain: e.data.domain, featured: e.data.featured }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<!-- Hidden until the script un-hides it, so without JavaScript the band takes no space at all. -->
<div class="constellation" data-constellation hidden>
  <canvas class="constellation__canvas" data-constellation-canvas aria-hidden="true"></canvas>
</div>
<script type="application/json" data-constellation-data set:html={JSON.stringify(nodes)} />

<!--
  A duplicate visual path, not the only route to anything: every node is a row in the work table
  below, and featured ones are links there. So the canvas is aria-hidden and out of the tab order.
  Every dot is one of the 21 real projects. There are no ambient particles.
-->
<script is:inline>
  (function () {
    var band = document.querySelector('[data-constellation]');
    var canvas = band && band.querySelector('[data-constellation-canvas]');
    var dataEl = document.querySelector('[data-constellation-data]');
    if (!band || !canvas || !dataEl || !canvas.getContext) return;
    var projects;
    try {
      projects = JSON.parse(dataEl.textContent);
    } catch (e) {
      return;
    }
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    band.hidden = false;

    var cs = getComputedStyle(document.documentElement);
    function token(name) {
      return cs.getPropertyValue(name).trim();
    }
    var C = {
      hairline: token('--hairline'),
      muted: token('--muted'),
      accent: token('--accent'),
      text: token('--text'),
      surface: token('--surface'),
      font: token('--font-mono')
    };

    // Deterministic seeding: FNV-1a of the slug feeds a small PRNG, so a project lands in the
    // same place on every load.
    function hash(str) {
      var h = 2166136261;
      for (var i = 0; i < str.length; i++) {
        h ^= str.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    }
    function rng(seed) {
      var a = seed;
      return function () {
        a = (a + 0x6d2b79f5) | 0;
        var t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // Four loose clusters, as fractions of the band: centre x and width.
    var CLUSTERS = {
      genai: { cx: 0.2, w: 0.34 },
      'computer-vision': { cx: 0.5, w: 0.2 },
      analytics: { cx: 0.72, w: 0.13 },
      ocr: { cx: 0.89, w: 0.13 }
    };
    var counts = {};
    var nodes = projects.map(function (p) {
      var i = counts[p.domain] || 0;
      counts[p.domain] = i + 1;
      return { p: p, i: i, hx: 0, hy: 0, x: 0, y: 0, ph: 0, ph2: 0, sp: 0, ax: 0, ay: 0 };
    });
    nodes.forEach(function (n) {
      var cl = CLUSTERS[n.p.domain];
      var total = counts[n.p.domain];
      var cols = total >= 8 ? 5 : total >= 4 ? 3 : 2;
      var rows = Math.ceil(total / cols);
      var r = rng(hash(n.p.slug));
      var col = n.i % cols;
      var row = Math.floor(n.i / cols);
      // Jittered grid cell inside the cluster, so nodes spread without piling up.
      n.hx = cl.cx + ((col + 0.5 + (r() - 0.5) * 0.7) / cols - 0.5) * cl.w;
      n.hy = 0.14 + ((row + 0.5 + (r() - 0.5) * 0.7) / rows) * 0.58;
      n.ph = r() * Math.PI * 2;
      n.ph2 = r() * Math.PI * 2;
      n.sp = 0.6 + r() * 0.8;
    });

    var W = 0;
    var H = 0;
    var dpr = 1;
    var ptr = null; // pointer in CSS px, or null
    var hover = null;

    function resize() {
      var rect = band.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    var AMP = 9;
    function place(time) {
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var bx = n.hx * W + Math.sin(time * 0.00031 * n.sp + n.ph) * AMP;
        var by = n.hy * H + Math.cos(time * 0.00027 * n.sp + n.ph2) * AMP;
        var tx = 0;
        var ty = 0;
        if (ptr && !reduce) {
          var dx = ptr.x - bx;
          var dy = ptr.y - by;
          var d = Math.sqrt(dx * dx + dy * dy);
          var R = 130;
          if (d < R && d > 0.5) {
            var f = (1 - d / R) * 0.3;
            tx = dx * f;
            ty = dy * f;
          }
        }
        n.ax += (tx - n.ax) * 0.08;
        n.ay += (ty - n.ay) * 0.08;
        n.x = bx + n.ax;
        n.y = by + n.ay;
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      var thr = Math.max(60, Math.min(110, W * 0.1));
      ctx.lineWidth = 1;
      for (var i = 0; i < nodes.length; i++) {
        for (var j = i + 1; j < nodes.length; j++) {
          var a = nodes[i];
          var b = nodes[j];
          var dx = a.x - b.x;
          var dy = a.y - b.y;
          var d = Math.sqrt(dx * dx + dy * dy);
          if (d >= thr) continue;
          var prox = 1 - d / thr;
          var near = false;
          if (ptr) {
            var mx = (a.x + b.x) / 2 - ptr.x;
            var my = (a.y + b.y) / 2 - ptr.y;
            near = mx * mx + my * my < 140 * 140;
          }
          ctx.strokeStyle = near ? C.muted : C.hairline;
          ctx.globalAlpha = near ? 0.25 + prox * 0.6 : 0.2 + prox * 0.8;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;

      // Domain captions sit under each cluster, in the same muted mono as the rest of the chrome.
      // On a narrow band the full names would collide, so they shrink to short forms without counts.
      var narrow = W < 520;
      ctx.font = (narrow ? 10 : 11) + 'px ' + C.font;
      ctx.textBaseline = 'alphabetic';
      ctx.fillStyle = C.muted;
      ctx.globalAlpha = 0.6;
      ctx.textAlign = 'center';
      for (var k in CLUSTERS) {
        var name = narrow ? (k === 'computer-vision' ? 'cv' : k) : k + ' ' + counts[k];
        ctx.fillText(name, CLUSTERS[k].cx * W, H - 10);
      }
      ctx.globalAlpha = 1;

      for (var m = 0; m < nodes.length; m++) {
        var n = nodes[m];
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.p.featured ? 5 : 3.5, 0, Math.PI * 2);
        if (n.p.featured) {
          ctx.fillStyle = C.surface;
          ctx.fill();
          ctx.strokeStyle = C.accent;
          ctx.lineWidth = 1.5;
          ctx.stroke();
        } else {
          ctx.fillStyle = n === hover ? C.text : C.muted;
          ctx.fill();
        }
      }

      if (hover) {
        ctx.font = '12px ' + C.font;
        var label = hover.p.title;
        var tw = ctx.measureText(label).width;
        var lx = Math.min(Math.max(hover.x - tw / 2, 6), W - tw - 6);
        var ly = hover.y - 14 < 18 ? hover.y + 24 : hover.y - 14;
        ctx.textAlign = 'left';
        ctx.fillStyle = C.surface;
        ctx.fillRect(lx - 4, ly - 12, tw + 8, 17);
        ctx.strokeStyle = C.hairline;
        ctx.lineWidth = 1;
        ctx.strokeRect(lx - 4 + 0.5, ly - 12 + 0.5, tw + 7, 16);
        ctx.fillStyle = C.text;
        ctx.fillText(label, lx, ly);
      }
    }

    function frame(time) {
      place(time);
      draw();
    }

    // One frame on demand (init, resize, hover). Under reduced motion this is all there is:
    // no loop, no drift, no cursor attraction.
    function still() {
      frame(0);
    }

    function pick(x, y) {
      var best = null;
      var bestD = 1e9;
      var reach = window.matchMedia('(pointer: coarse)').matches ? 20 : 12;
      for (var i = 0; i < nodes.length; i++) {
        var dx = nodes[i].x - x;
        var dy = nodes[i].y - y;
        var d = Math.sqrt(dx * dx + dy * dy);
        if (d < reach && d < bestD) {
          best = nodes[i];
          bestD = d;
        }
      }
      return best;
    }

    function local(ev) {
      var r = canvas.getBoundingClientRect();
      return { x: ev.clientX - r.left, y: ev.clientY - r.top };
    }

    var raf = 0;
    var visible = true;
    function loop(time) {
      frame(time);
      raf = requestAnimationFrame(loop);
    }
    function start() {
      if (reduce || raf || !visible || document.hidden) return;
      raf = requestAnimationFrame(loop);
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    canvas.addEventListener('pointermove', function (ev) {
      ptr = local(ev);
      var h = pick(ptr.x, ptr.y);
      canvas.style.cursor = h ? 'pointer' : '';
      if (h !== hover) {
        hover = h;
        if (!raf) still();
      }
    });
    canvas.addEventListener('pointerleave', function () {
      ptr = null;
      hover = null;
      canvas.style.cursor = '';
      if (!raf) still();
    });
    canvas.addEventListener('click', function (ev) {
      var p = local(ev);
      var n = pick(p.x, p.y);
      if (!n) return;
      if (n.p.featured) {
        window.location.href = '/work/' + n.p.slug + '/';
        return;
      }
      var row = document.querySelector('tr[data-slug="' + n.p.slug + '"]');
      if (!row) return;
      if (row.hidden) {
        // A domain filter is hiding it; clear the filter so the row exists on screen.
        var all = document.querySelector('[data-filter="all"]');
        if (all) all.click();
      }
      row.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      row.setAttribute('data-flash', '');
      setTimeout(function () {
        row.removeAttribute('data-flash');
      }, 1600);
    });

    var resizeTimer = 0;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        resize();
        if (!raf) still();
      }, 100);
    });

    resize();
    still();

    if (!reduce) {
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          visible = entries[entries.length - 1].isIntersecting;
          if (visible) start();
          else stop();
        }).observe(band);
      }
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });
      start();
    }
  })();
</script>

<style>
  .constellation {
    height: 240px;
    margin-bottom: var(--space-5);
    border-block: var(--border);
  }
  [data-constellation][hidden] {
    display: none;
  }
  .constellation__canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* Vertical swipes over the band still scroll the page. */
    touch-action: pan-y;
  }
  @media (max-width: 40rem) {
    .constellation {
      height: 160px;
    }
  }
</style>
