---
// EDAA: React frontend -> preprocessor -> ASR+SBERT and YOLO containers -> GCS -> frontend plots with Plotly.js.
---

<figure class="diagram" data-diagram>
  <svg viewBox="0 0 480 584" role="img" aria-labelledby="edaa-title edaa-desc">
    <title id="edaa-title">EDAA architecture</title>
    <desc id="edaa-desc">A React frontend uploads the encoded video. A preprocessor decodes it, extracts audio with moviepy and splits audio and video into 10-second chunks. The ASR container transcribes audio chunks and the SBERT container predicts sentiment, writing per-interval records to a GCS bucket. The YOLO container reads video chunks and writes per-interval face counts to the bucket. The frontend retrieves both result sets and plots them with Plotly.js.</desc>
    <defs>
      <marker id="edaa-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path class="arrowhead" d="M0 0 L10 5 L0 10 z" />
      </marker>
    </defs>

    <rect class="node" x="140" y="10" width="200" height="48" />
    <text x="240" y="31">React frontend</text>
    <text class="sub" x="240" y="48">uploads encoded video</text>

    <path class="edge" d="M240 58 V86" marker-end="url(#edaa-arrow)" />

    <rect class="node" x="90" y="88" width="300" height="52" />
    <text x="240" y="109">Preprocessor</text>
    <text class="sub" x="240" y="126">decode · moviepy audio · 10 s chunks</text>

    <path class="edge" d="M240 140 V158 H125 V206" marker-end="url(#edaa-arrow)" />
    <path class="edge" d="M240 158 H355 V206" marker-end="url(#edaa-arrow)" />
    <text class="tag" x="135" y="188">audio chunks</text>
    <text class="tag" x="365" y="188">video chunks</text>

    <rect class="node" x="25" y="208" width="200" height="48" />
    <text x="125" y="229">ASR container</text>
    <text class="sub" x="125" y="246">transcribes each chunk</text>
    <rect class="node" x="255" y="208" width="200" height="48" />
    <text x="355" y="229">YOLO container</text>
    <text class="sub" x="355" y="246">faces per chunk</text>

    <path class="edge" d="M125 256 V284" marker-end="url(#edaa-arrow)" />

    <rect class="node" x="25" y="286" width="200" height="48" />
    <text x="125" y="307">SBERT container</text>
    <text class="sub" x="125" y="324">sentence sentiment</text>

    <path class="edge" d="M125 334 V372" marker-end="url(#edaa-arrow)" />
    <path class="edge" d="M355 256 V372" marker-end="url(#edaa-arrow)" />

    <rect class="frame hl" x="20" y="374" width="440" height="88" />
    <text class="tag" x="32" y="392">GCS bucket</text>
    <text class="sub" x="125" y="418">per interval:</text>
    <text class="sub" x="125" y="434">sentence · prediction</text>
    <text class="sub" x="125" y="450">start · stop</text>
    <text class="sub" x="355" y="418">per interval:</text>
    <text class="sub" x="355" y="434">positive · neutral ·</text>
    <text class="sub" x="355" y="450">negative face counts</text>

    <path class="edge" d="M240 462 V490" marker-end="url(#edaa-arrow)" />
    <text class="tag" x="250" y="480">retrieve</text>

    <rect class="frame" x="20" y="492" width="440" height="82" />
    <text class="tag" x="32" y="510">React frontend</text>
    <rect class="node" x="140" y="520" width="200" height="46" />
    <text x="240" y="540">Plotly.js</text>
    <text class="sub" x="240" y="556">plots both result sets</text>
  </svg>
  <figcaption>EDAA, from uploaded recording to per-interval audience report.</figcaption>
</figure>
