---
import TerminalFrame from './TerminalFrame.astro';
import Prompt from './Prompt.astro';
import profile from '../content/profile.json';
import experience from '../content/experience.json';

// The current company is derived, not duplicated: the single entry with no end date.
const current = experience.find((e) => e.end === null);
if (!current) throw new Error('experience.json has no current (end: null) entry');

// The whoami output is lowercased here, in the markup, as a terminal affectation.
const whoami = `${profile.name} — ${profile.role} @ ${current.company}`.toLowerCase();
const where = profile.location.toLowerCase();
---

<TerminalFrame>
  <div class="boot" data-boot>
    <Prompt as="div" command="whoami" />
    <h1 class="boot__out" data-type>{whoami}</h1>
    <p class="boot__out" data-type>{where}</p>

    <div class="boot__gap"></div>

    <Prompt as="div" command="cat positioning.txt" />
    <p class="boot__out" data-type>{profile.positioning}<span class="caret" data-caret aria-hidden="true"></span></p>
  </div>
</TerminalFrame>

<!--
  Progressive enhancement. The complete text above is already in the HTML. With
  JavaScript off, or with reduced motion on, nothing below runs and the page reads
  exactly as it does when the animation finishes. The script never injects text:
  it splits each line's existing text node into a shown span and a hidden span
  and moves characters from one to the other.
-->
<script is:inline>
  (function () {
    var boot = document.querySelector('[data-boot]');
    if (!boot) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var caret = boot.querySelector('[data-caret]');
    var lines = [];
    boot.querySelectorAll('[data-type]').forEach(function (el) {
      var node = el.firstChild;
      if (!node || node.nodeType !== 3) return;
      var shown = document.createElement('span');
      var hidden = document.createElement('span');
      hidden.className = 'boot__pending';
      hidden.textContent = node.nodeValue;
      el.replaceChild(hidden, node);
      el.insertBefore(shown, hidden);
      lines.push({ shown: shown, hidden: hidden, el: el });
    });

    boot.classList.add('is-typing');

    var li = 0;
    function park(line) {
      if (caret) line.el.insertBefore(caret, line.hidden);
    }
    function step() {
      if (li >= lines.length) {
        // Finish with the caret after the last character, as in the static markup.
        var last = lines[lines.length - 1];
        if (caret && last) last.el.appendChild(caret);
        boot.classList.remove('is-typing');
        return;
      }
      var line = lines[li];
      park(line);
      var rest = line.hidden.textContent;
      if (!rest) {
        li++;
        setTimeout(step, 0);
        return;
      }
      line.shown.textContent += rest.charAt(0);
      line.hidden.textContent = rest.slice(1);
      if (!line.hidden.textContent) {
        li++;
        setTimeout(step, line.el.classList.contains('prompt__command') ? 250 : 180);
      } else {
        setTimeout(step, 16);
      }
    }
    step();
  })();
</script>

<style>
  .boot {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }
  .boot__out {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    line-height: inherit;
    color: var(--text);
  }
  .boot__gap {
    height: var(--space-4);
  }
  /* Characters not yet typed keep their layout space but are not painted. */
  .boot :global(.boot__pending) {
    visibility: hidden;
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
  }
  /* The caret blinks only when the visitor has not asked for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: caret-blink 1.1s steps(1) infinite;
    }
    .boot.is-typing .caret {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
